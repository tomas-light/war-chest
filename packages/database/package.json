{
  "name": "@war-chest/database",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./src/migrate.ts",
    "db:seed": "tsx ./src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test ./tests/*.test.ts",
    "types:build": "tsc --build",
    "types:watch": "tsc --build --watch"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
