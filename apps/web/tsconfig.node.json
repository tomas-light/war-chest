{
  "extends": "../../tsconfig.apps-base.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "paths": {
      "#/*": ["./src/*"]
    },
    "tsBuildInfoFile": "../../ts-builds/apps/web-node.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "config",
    "playwright/gallery",
    "playwright.config.ts",
    "playwright.real.config.ts",
    "src/app/i18n/initializeI18n.ts",
    "src/shared/config/supportedLanguages.ts",
    "tests/e2e",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/config"
    }
  ]
}
