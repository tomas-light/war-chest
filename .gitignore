.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules
ts-builds
*.tsbuildinfo

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*
/.idea/*

# Per-application and per-package local configuration
apps/*/env.local.yaml
packages/*/env.local.yaml

# Local mount point for external runtime feature flags
/runtime/feature-flags/

# Test and build output
apps/*/coverage/
apps/*/dist/
apps/*/playwright-report/
apps/*/test-results/

# Docker Compose local overrides and credentials
/.env
